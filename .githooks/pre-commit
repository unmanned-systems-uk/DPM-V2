#!/bin/bash

# Pre-commit hook for DPM-V2 documentation enforcement
#
# Purpose: Remind developers to update documentation when code changes
#
# Installation:
#   git config core.hooksPath .githooks
#
# To bypass this hook (use sparingly):
#   git commit --no-verify

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo ""
echo "🔍 Running pre-commit documentation check..."
echo ""

# Check if code files changed
CODE_CHANGED=$(git diff --cached --name-only | grep -E '(sbc/|android/|SystemTools/|docs/protocol/)' | wc -l)

# Check if documentation files changed
DOCS_CHANGED=$(git diff --cached --name-only | grep -E '(docs/architecture/)' | wc -l)

# List of changed code files
CHANGED_CODE_FILES=$(git diff --cached --name-only | grep -E '(sbc/|android/|SystemTools/|docs/protocol/)')

if [ "$CODE_CHANGED" -gt 0 ] && [ "$DOCS_CHANGED" -eq 0 ]; then
    echo -e "${YELLOW}⚠️  WARNING: Code changed but no documentation updates detected.${NC}"
    echo ""
    echo -e "   ${YELLOW}Changed code files:${NC}"
    echo "$CHANGED_CODE_FILES" | while read file; do
        echo "      - $file"
    done
    echo ""
    echo -e "   ${YELLOW}Did you update docs/architecture/ as needed?${NC}"
    echo ""
    echo "   Documentation requirements:"
    echo "   • Component changes → update view-logical.md"
    echo "   • Architecture changes → update C4 diagrams"
    echo "   • Protocol changes → update BOTH PropertyLoader (C++ AND Kotlin)"
    echo "   • Decisions made → create/update ADR"
    echo ""
    echo "   See CONTRIBUTING.md for full requirements."
    echo "   See docs/DOCUMENTATION_UPDATE_GUIDE.md for quick reference."
    echo ""
    echo -e "   ${RED}If documentation update is not needed, commit with:${NC}"
    echo -e "   ${RED}git commit --no-verify${NC}"
    echo ""
    exit 1
fi

# If both code and docs changed, check if protocol was changed
if [ "$CODE_CHANGED" -gt 0 ] && [ "$DOCS_CHANGED" -gt 0 ]; then
    PROTOCOL_CHANGED=$(echo "$CHANGED_CODE_FILES" | grep -c 'docs/protocol/' || true)

    if [ "$PROTOCOL_CHANGED" -gt 0 ]; then
        # Check if PropertyLoader was updated in both domains
        CPP_LOADER_CHANGED=$(git diff --cached --name-only | grep -c 'property_loader.cpp' || true)
        KOTLIN_LOADER_CHANGED=$(git diff --cached --name-only | grep -c 'PropertyLoader.kt' || true)

        if [ "$CPP_LOADER_CHANGED" -eq 0 ] || [ "$KOTLIN_LOADER_CHANGED" -eq 0 ]; then
            echo -e "${RED}⚠️  CRITICAL: Protocol changed but PropertyLoader not updated in both domains!${NC}"
            echo ""
            echo "   Protocol changes detected in:"
            echo "$CHANGED_CODE_FILES" | grep 'docs/protocol/' | while read file; do
                echo "      - $file"
            done
            echo ""
            echo -e "   ${RED}REQUIRED: Update PropertyLoader in BOTH domains:${NC}"
            if [ "$CPP_LOADER_CHANGED" -eq 0 ]; then
                echo -e "      ${RED}❌ Missing: sbc/src/property_loader.cpp${NC}"
            else
                echo -e "      ${GREEN}✅ Updated: sbc/src/property_loader.cpp${NC}"
            fi
            if [ "$KOTLIN_LOADER_CHANGED" -eq 0 ]; then
                echo -e "      ${RED}❌ Missing: android/.../PropertyLoader.kt${NC}"
            else
                echo -e "      ${GREEN}✅ Updated: android/.../PropertyLoader.kt${NC}"
            fi
            echo ""
            echo "   This is a MANDATORY requirement to prevent sync bugs (see Issue #22)."
            echo ""
            echo -e "   ${RED}Fix and re-commit, or use --no-verify if intentional.${NC}"
            echo ""
            exit 1
        else
            echo -e "${GREEN}✅ Protocol changed and PropertyLoader updated in both domains${NC}"
        fi
    fi

    echo -e "${GREEN}✅ Code and documentation both updated${NC}"
fi

# If only docs changed, allow commit
if [ "$CODE_CHANGED" -eq 0 ] && [ "$DOCS_CHANGED" -gt 0 ]; then
    echo -e "${GREEN}✅ Documentation-only change${NC}"
fi

# If neither code nor docs changed, allow commit
if [ "$CODE_CHANGED" -eq 0 ] && [ "$DOCS_CHANGED" -eq 0 ]; then
    echo -e "${GREEN}✅ No code or documentation changes${NC}"
fi

echo ""
echo -e "${GREEN}✅ Pre-commit check passed${NC}"
echo ""

exit 0
