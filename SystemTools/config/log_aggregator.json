{
  "network": {
    "air_side": {
      "protocol": "udp",
      "host": "0.0.0.0",
      "port": 5007,
      "buffer_size": 4096
    },
    "ground_side": {
      "protocol": "tcp",
      "host": "0.0.0.0",
      "port": 5008,
      "buffer_size": 4096
    },
    "discovery": {
      "enabled": true,
      "target_host": "10.0.1.53",
      "target_port": 5009,
      "interval_seconds": 10,
      "payload": {
        "type": "discovery",
        "source": "systemtools"
      }
    }
  },
  "display": {
    "colors": {
      "AIR": "blue",
      "GROUND": "magenta"
    },
    "level_colors": {
      "ERROR": "red",
      "WARNING": "orange",
      "INFO": "green",
      "DEBUG": "gray"
    },
    "show_timestamp": true,
    "show_thread": false,
    "show_function": false,
    "show_line": false,
    "indent_fields": true
  },
  "buffer": {
    "max_entries": 10000
  },
  "filtering": {
    "default_level": null,
    "default_context": null,
    "default_domain": null
  },
  "export": {
    "default_format": "json",
    "output_dir": "logs/exports"
  },
  "analytics": {
    "enabled": true,
    "database_path": "data/performance.db",
    "data_retention_days": 7,
    "update_interval_sec": 5,
    "alert_thresholds": {
      "cpu_warn": 70,
      "cpu_critical": 90,
      "memory_warn_mb": 6000,
      "memory_critical_mb": 7000,
      "disk_warn_mb": 25000,
      "disk_critical_mb": 28000,
      "network_rx_warn_mbps": 400,
      "network_rx_critical_mbps": 450,
      "network_tx_warn_mbps": 400,
      "network_tx_critical_mbps": 450,
      "camera_latency_warn_ms": 40,
      "camera_latency_critical_ms": 100,
      "camera_disconnected_warn_sec": 5,
      "camera_disconnected_critical_sec": 30,
      "tcp_disconnected_warn_sec": 10,
      "tcp_disconnected_critical_sec": 60,
      "queue_depth_warn": 10,
      "queue_depth_critical": 50
    },
    "anomaly_detection": {
      "z_score_threshold": 3.0,
      "rate_of_change_threshold_percent": 30
    }
  }
}
