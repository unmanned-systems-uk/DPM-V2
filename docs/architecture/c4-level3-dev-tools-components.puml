@startuml Dev-Tools Component Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' Dev-Tools Component Diagram (C4 Level 3)
' Shows internal components of the SystemTools diagnostic suite

title Dev-Tools (SystemTools) Component Diagram

Container_Boundary(dev_tools, "SystemTools (Python, Tkinter Desktop Application)") {
    Component(main_window, "MainWindow", "Tkinter", "Application main window with tabbed interface")

    ' Tab Components
    Component(connection_tab, "ConnectionTab", "Tkinter Frame", "Network connection management and status")
    Component(camera_tab, "CameraTab", "Tkinter Frame", "Camera control testing panel with debug mode")
    Component(network_tab, "NetworkTab", "Tkinter Frame", "Network diagnostics and packet monitoring")
    Component(logs_tab, "LogsTab", "Tkinter Frame", "Real-time log viewer and analysis")

    ' Network Layer
    Component(tcp_client, "TcpClient", "Python sockets", "TCP command client for Air-Side communication")
    Component(udp_listener, "UdpListener", "Python sockets", "UDP status and heartbeat listener")
    Component(protocol_handler, "ProtocolHandler", "Python", "Message serialization and protocol validation")

    ' Diagnostic Components
    Component(packet_analyzer, "PacketAnalyzer", "Python", "Network packet analysis and statistics")
    Component(connection_monitor, "ConnectionMonitor", "Python", "Connection health monitoring and auto-reconnect")
    Component(command_builder, "CommandBuilder", "Python", "Interactive command construction and testing")
    Component(response_validator, "ResponseValidator", "Python", "Protocol response validation and error detection")

    ' Data Components
    Component(property_loader, "PropertyLoader", "Python", "Loads camera property specifications")
    Component(log_parser, "LogParser", "Python", "Parses and analyzes Air-Side logs")

    ComponentDb(property_specs, "Property Specs", "JSON files", "Camera property definitions")
    ComponentDb(diagnostics_log, "Diagnostics Log", "Text files", "Saved diagnostic sessions")
}

Person(developer, "Developer", "Diagnoses system issues")
Container_Ext(air_side, "Air-Side Service", "Raspberry Pi 5")
Container_Ext(tcp_channel, "TCP Command", "Port 5000")
Container_Ext(udp_status, "UDP Status", "Port 5001")
Container_Ext(udp_heartbeat, "UDP Heartbeat", "Port 5002")

' Developer interaction
Rel(developer, connection_tab, "Manages connections")
Rel(developer, camera_tab, "Tests camera commands")
Rel(developer, network_tab, "Monitors packets")
Rel(developer, logs_tab, "Views diagnostics")

' Tab → Network Layer
Rel(connection_tab, connection_monitor, "Controls connection")
Rel(camera_tab, tcp_client, "Sends test commands")
Rel(camera_tab, command_builder, "Builds commands")
Rel(network_tab, packet_analyzer, "Displays packet stats")
Rel(logs_tab, log_parser, "Parses logs")

' Network Layer interactions
Rel(tcp_client, tcp_channel, "Sends/receives")
Rel(udp_listener, udp_status, "Monitors")
Rel(udp_listener, udp_heartbeat, "Monitors")
Rel(connection_monitor, tcp_client, "Manages")
Rel(connection_monitor, udp_listener, "Monitors")

' Protocol handling
Rel(tcp_client, protocol_handler, "Serializes/deserializes")
Rel(udp_listener, protocol_handler, "Deserializes")
Rel(command_builder, protocol_handler, "Validates command format")
Rel(tcp_client, response_validator, "Validates responses")

' Data access
Rel(command_builder, property_loader, "Queries valid values")
Rel(property_loader, property_specs, "Loads")
Rel(packet_analyzer, diagnostics_log, "Saves sessions")

' Diagnostics
Rel(response_validator, camera_tab, "Displays validation results")
Rel(packet_analyzer, network_tab, "Updates statistics")

' SSH access to Air-Side
Rel(logs_tab, air_side, "Fetches logs", "SSH/SCP")
Rel(log_parser, air_side, "Retrieves system info", "SSH")

SHOW_LEGEND()

note right of camera_tab
  **Debug Mode Features:**
  - Manual command testing
  - Focus controls (Near/Far/Stop)
  - AF Hold testing
  - Property setter
  - Real-time diagnostics output
  - Response validation
  - Error analysis
end note

note right of packet_analyzer
  **Diagnostics Capabilities:**
  - Packet rate monitoring
  - Message type statistics
  - Latency measurement
  - Error detection
  - Protocol compliance checking
  - Connection quality metrics
end note

note right of connection_monitor
  **Connection Management:**
  - Multi-domain connection tracking
  - Auto-reconnect logic
  - Health check monitoring
  - Connection state visualization
  - Timeout detection
end note

@enduml
